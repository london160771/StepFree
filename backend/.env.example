# Copy to backend/.env for local development. Never commit backend/.env.

# Port for the Express API.
PORT=4000

# FalkorDB connection. Local default shown; FalkorDB Cloud uses a redis:// or rediss:// URL with credentials.
FALKORDB_URL=redis://127.0.0.1:6379

# Optional TfL Unified API key (https://api-portal.tfl.gov.uk). Works without one at lower rate limits.
TFL_APP_KEY=

# Frontend origin allowed by CORS.
CORS_ORIGIN=http://localhost:5173

# Gemini API key for the StepFree journey agent (https://aistudio.google.com/apikey). Server-side only: never expose it to the browser or commit it.
# The agent uses model gemini-3.8-flash through the StepFree MCP server. Without it, the journey agent reports that it is unavailable.
GEMINI_API_KEY=
